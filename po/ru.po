#: whoohub/backends.py:26
msgid "Arch repositories (pacman)"
msgstr "Репозитории Arch (pacman)"

#: whoohub/backends.py:27
msgid ""
"A distribution package: updated together with the system (pacman -Syu). "
"Needs your password."
msgstr ""
"Пакет дистрибутива: обновляется вместе с системой (pacman -Syu). Нужен "
"пароль."

#: whoohub/backends.py:28
msgid "Flathub"
msgstr "Flathub"

#: whoohub/backends.py:29
msgid ""
"A sandboxed Flatpak, installed for your user without a password. Usually the "
"newest version."
msgstr ""
"Flatpak в песочнице, ставится в твой профиль без пароля. Обычно самая свежая "
"версия."

#: whoohub/backends.py:30
msgid "AUR"
msgstr "AUR"

#: whoohub/backends.py:31
msgid ""
"Built from a community script (PKGBUILD) — worth reading before installing."
msgstr ""
"Сборка из скрипта сообщества (PKGBUILD) — перед установкой его стоит "
"просмотреть."

#: whoohub/backends.py:32
msgid "AppImage"
msgstr "AppImage"

#: whoohub/backends.py:33
msgid ""
"A single file from the author's GitHub, nothing installed system-wide. Does "
"not update itself."
msgstr ""
"Один файл с GitHub автора, без установки в систему. Сам не обновляется."

#: whoohub/backends.py:136 whoohub/backends.py:144 whoohub/backends.py:326
#: whoohub/updates.py:148
msgid "Cancelled"
msgstr "Отменено"

#: whoohub/backends.py:146
msgid "No password entered — nothing was changed"
msgstr "Пароль не введён — ничего не изменено"

#: whoohub/backends.py:148
#, python-brace-format
msgid "The command failed (exit code {code})"
msgstr "Команда завершилась с ошибкой (код {code})"

#: whoohub/backends.py:153
msgid "Done"
msgstr "Готово"

#: whoohub/backends.py:157
#, python-brace-format
msgid "Error: {error}"
msgstr "Ошибка: {error}"

#: whoohub/backends.py:164
msgid ""
"pacman could not install the package. If the log says “404” or “not found”, "
"update the system first (sudo pacman -Syu)"
msgstr ""
"pacman не смог установить пакет. Если в логе «404» или «не найден» — сначала "
"обнови систему (sudo pacman -Syu)"

#: whoohub/backends.py:166
#, python-brace-format
msgid "{name} installed"
msgstr "{name} установлен"

#: whoohub/backends.py:173
msgid ""
"pacman could not remove the package (other packages may need it — see the "
"log)"
msgstr ""
"pacman не смог удалить пакет (возможно, он нужен другим пакетам — см. лог)"

#: whoohub/backends.py:174
#, python-brace-format
msgid "{name} removed"
msgstr "{name} удалён"

#: whoohub/backends.py:187
msgid "Could not add Flathub for your user"
msgstr "Не удалось подключить Flathub для твоего пользователя"

#: whoohub/backends.py:194
msgid "Flatpak could not install the app"
msgstr "Flatpak не смог установить программу"

#: whoohub/backends.py:195
msgid "Installed from Flathub"
msgstr "Установлено из Flathub"

#: whoohub/backends.py:203
msgid "Flatpak could not remove the app"
msgstr "Flatpak не смог удалить программу"

#: whoohub/backends.py:204 whoohub/backends.py:366
msgid "Removed"
msgstr "Удалено"

