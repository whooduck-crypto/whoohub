msgid "Could not update the AUR sources"
msgstr "Не удалось обновить исходники из AUR"

#: whoohub/backends.py:247
msgid "Could not download the package from the AUR"
msgstr "Не удалось скачать пакет из AUR"

#: whoohub/backends.py:254
#, python-brace-format
msgid ""
"It needs packages that are not in the repositories (they are in the AUR "
"too): {names}. Install them first."
msgstr ""
"Нужны пакеты, которых нет в репозиториях (они тоже из AUR): {names}. "
"Установи их сначала."

#: whoohub/backends.py:256
#, python-brace-format
msgid "Installing dependencies from the repositories: {names}"
msgstr "Ставлю зависимости из репозиториев: {names}"

#: whoohub/backends.py:258
msgid "Could not install the dependencies"
msgstr "Не удалось поставить зависимости"

#: whoohub/backends.py:259
msgid "The build failed"
msgstr "Сборка не удалась"

#: whoohub/backends.py:264
msgid "makepkg did not produce a package"
msgstr "makepkg не создал пакет"

#: whoohub/backends.py:266
