msgstr "Не удалось установить собранный пакет"

#: whoohub/backends.py:267
#, python-brace-format
msgid "{name} built and installed"
msgstr "{name} собран и установлен"

#: whoohub/backends.py:299
msgid "This app has no GitHub link — download it from the author's page"
msgstr "У этой программы нет ссылки на GitHub — скачай её со страницы автора"

#: whoohub/backends.py:300
#, python-brace-format
msgid "Looking for the latest release on GitHub: {repo}"
msgstr "Ищу последний выпуск на GitHub: {repo}"

#: whoohub/backends.py:310
msgid "(pre-release)"
msgstr "(предварительный)"

#: whoohub/backends.py:313
msgid "The GitHub releases have no .AppImage file for x86_64"
msgstr "В выпусках на GitHub нет файла .AppImage для x86_64"

